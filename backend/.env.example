# Optisight Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
# NeonDB (PostgreSQL) connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT Secret — REQUIRED. The server refuses to start without it, and rejects
# any value shorter than 32 characters. There is no fallback (SEC-AUTH-001).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Set to "production" in deployed environments so errors are generic and no
# stack traces are returned to clients (SEC-ERR-001).
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins permitted to call the API and
# open a socket (SEC-CONF-001). Defaults to the local Nuxt dev origin.
CORS_ORIGINS=http://localhost:3000
